# Copy to .env.local and fill in. Only needed to send applications and digests.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=

# Safety cap on applications sent in any 24 hours.
DAILY_SEND_LIMIT=25

# Used for links inside the digest email.
APP_URL=http://localhost:3000
